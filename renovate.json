{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>martinemde/renovate-config#v1.1.0"
  ],
  "schedule": [
    "before 9am"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "renovate-config"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "automerge": false
    }
  ]
}
