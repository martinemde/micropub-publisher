# GitHub App user authorization (not installation/app authentication).
# Use the GitHub App client ID and client secret; no private key is needed.
# Production callback: https://publish.martinemde.com/login/callback
# Development callback for a separate dev app: http://localhost:5180/login/callback
# Install only on selected publishing repositories; Contents: read and write.
# Leave user access token expiration enabled; the server refreshes user tokens.
GITHUB_CLIENT_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret

# GitHub Repository Configuration
# The owner and repository name where blog posts will be committed
GITHUB_OWNER=martinemde
GITHUB_REPO=your_repository_name

# Session Encryption
# Generate a strong random string for encrypting session cookies
# Example: openssl rand -base64 32
SESSION_SECRET=your_random_32_char_or_longer_secret_key

# Publisher URL (where this application is deployed)
PUBLIC_APP_URL=https://publish.martinemde.com

# Published site URL (the IndieAuth identity and public post/media origin)
PUBLIC_SITE_URL=https://martinemde.com

# Micropub Storage Backend (optional)
# Options: github, file, test
# Default: auto-detects (file in dev mode, github in production)
MICROPUB_BACKEND=github

# OAuth Callback URLs (for reference):
# - GitHub (blog editor): /login/callback

# For local development, use the dev app credentials and PUBLIC_APP_URL
# http://localhost:5180, and MICROPUB_BACKEND=file (or an isolated test repo).
